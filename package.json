{
  "name": "ezpg",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn format && lsof -t -i tcp:8080 -i tcp:3000 -i tcp:3001 -i tcp:5555 | xargs -r kill -9 && turbo run dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "lint:fix": "ESLINT_FLAGS=\"--fix\" turbo lint",
    "eslintrc-lint": "eslint --no-eslintrc --parser-options=ecmaVersion:2020 \"**/*.{js,jsx}\" --ignore-pattern \"node_modules/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"**/*.{ts,tsx}\" --fix",
    "test": "turbo test",
    "format": "prettier --write . && cd packages/database && npx prisma format",
    "with-env": "dotenv -e ./apps/server/.env --",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf .turbo",
    "clean:all": "yarn clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' +",
    "prisma:migrate:reset": "yarn with-env yarn workspace @ezpg/database run migrate:reset",
    "prisma:generate": "yarn with-env yarn workspace @ezpg/database run db:generate",
    "prisma:studio": "yarn with-env yarn workspace @ezpg/database run studio",
    "generate:openapi:spec": "yarn prisma:generate && yarn with-env ts-node -r tsconfig-paths/register --project apps/server/tsconfig.json apps/server/src/generate-spec.ts",
    "generate:api:local": "yarn generate:openapi:spec && yarn workspace @ezpg/api-client generate:api",
    "generate:api": "yarn generate:api:local",
    "db:reset-seed": "yarn with-env yarn workspace @ezpg/server run db:reset-seed"
  },
  "dependencies": {
