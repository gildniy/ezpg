{
  "name": "@ezpg/helpers",
  "version": "1.0.0",
  "private": true,
  "description": "Shared helper utilities for EZPG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/**/*.ts -c .eslintrc.js",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "hi-base32": "^0.5.1",
    "thirty-two": "^1.0.2",
    "camelcase-keys": "^9.1.3",
    "snakecase-keys": "^8.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  }
}
